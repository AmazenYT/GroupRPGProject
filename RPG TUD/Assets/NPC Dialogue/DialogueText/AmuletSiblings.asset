  m_Script: {fileID: 11500000, guid: 5a3abc41843009f42863cada6ebc3ae2, type: 3}
  m_Name: AmuletSiblings
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speaker: Sibling 1
    text: No! It's my turn with the mysterious amulet!
    voiceLine: {fileID: 8300000, guid: df9de46968e18054aa0638057037a3f5, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: Sibling 2
    text: "You've had the mysterious amulet all week\u2026 it's MY turn!!"
    voiceLine: {fileID: 8300000, guid: 795ba2a12a82ae84ab3b0b65d979e882, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: Sibling 1
    text: I'm gonna tell the mayor about the mysterious amulet if you don't give
      it back NOW!
    voiceLine: {fileID: 8300000, guid: 2a459abc1f9dc80409762ef9a5c6635a, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: Sibling 2
    text: "No fair\u2026 "
    voiceLine: {fileID: 8300000, guid: 0ad0b8969596ed84595d550c9b3c5d6d, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
