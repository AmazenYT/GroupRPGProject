  m_Script: {fileID: 11500000, guid: 5a3abc41843009f42863cada6ebc3ae2, type: 3}
  m_Name: GuyOutsideTown
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speaker: 'Guy just outside of town:'
    text: Hark, bro! These woods sap energy from me like you would not belieeeve,
      brah.
    voiceLine: {fileID: 8300000, guid: c737d20627efe6e4cab8b967fe4fd415, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: 'Guy just outside of town:'
    text: Be careful on your perilous trek!
    voiceLine: {fileID: 8300000, guid: 6729aa0a3e7781c48895992ca9486635, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: 'Guy just outside of town:'
    text: Some dark and sinister creature lays ahead in the Scary Volcano place,
      dude.
    voiceLine: {fileID: 8300000, guid: b3776242d1968bb42bc0be4bcc3d4893, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
  - speaker: 'Guy just outside of town:'
    text: Watch out! Remain vigilant.
    voiceLine: {fileID: 8300000, guid: 5d01bd1dda1eece41966bf1fffc4f836, type: 3}
    questToStart: {fileID: 0}
    questToComplete: {fileID: 0}
